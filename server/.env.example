# MongoDB connection string (Atlas or local). Never commit the real .env.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/checkpoint

# Secret used to sign JWTs for admin and conductor sessions.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

PORT=4000

# Comma-separated origins allowed to call the API (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# Live traffic (optional). Without a key, ETAs use the static route baselines
# and nothing here is ever called.
#   tomtom — free tier, no credit card: https://developer.tomtom.com
TRAFFIC_PROVIDER=tomtom
# Any number of keys, used in turn; a key TomTom refuses (out of credits, bad
# key, rate limit) is skipped until it recovers. Add TRAFFIC_API_KEY3, 4, ...
# as needed. Leave them all unset to run on static baselines.
TRAFFIC_API_KEY1=
TRAFFIC_API_KEY2=

# Set on any public deployment. While the system has no accounts, /setup can
# create the first admin; this token stops a stranger claiming it first.
SETUP_TOKEN=
